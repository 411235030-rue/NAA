@page "/"
@implements IDisposable
@inject UserSession UserSession
@inject DdmApiService DdmApiService
@inject HistoryState HistoryState

<PageTitle>小護天使</PageTitle>

<div class="chat-home">
    @if (messages.Count == 0)
    {
        <div class="welcome">
            <div class="assistant-logo">✚</div>
            <div class="welcome-kicker">NURSING AI ASSISTANT</div>
            <h1>今天需要什麼協助？</h1>
            <p>
                歡迎，@UserSession.Account。小護天使可以協助你快速查詢臨床照護、操作流程與交班重點。
            </p>

            <div class="connection-note">
                <span class="connection-dot"></span>
                DDM 已接入前端；問答完成後由 DDM 儲存歷史紀錄，前端只負責載入與顯示。
            </div>

            <div class="quick-grid">
                <button class="quick-card" type="button" @onclick='() => UsePrompt("抽痰時血氧下降該怎麼處理？")'>
                    <div class="quick-icon">🫁</div>
                    <div>
                        <strong>呼吸照護</strong>
                        <span>抽痰、氧氣治療等相關問題</span>
                    </div>
                </button>

                <button class="quick-card" type="button" @onclick='() => UsePrompt("臨床給藥時有哪些重要注意事項？")'>
                    <div class="quick-icon">💉</div>
                    <div>
                        <strong>臨床處置</strong>
                        <span>給藥與常見臨床處置</span>
                    </div>
                </button>

                <button class="quick-card" type="button" @onclick='() => UsePrompt("請幫我整理交班時需要注意的重點。")'>
                    <div class="quick-icon">📋</div>
                    <div>
                        <strong>交班重點</strong>
                        <span>協助快速整理重要資訊</span>
                    </div>
                </button>

                <button class="quick-card" type="button" @onclick='() => UsePrompt("請提供常見護理操作的流程提醒。")'>
                    <div class="quick-icon">🩺</div>
                    <div>
                        <strong>操作流程</strong>
                        <span>查詢護理技術與執行步驟</span>
                    </div>
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="chat-thread">
            <div class="thread-header">
                <div>
                    <strong>@threadTitle</strong>
                    <span>@threadSubtitle</span>
                </div>
                <button type="button" class="clear-chat" @onclick="ClearChat">新對話</button>
            </div>

            <div class="message-list">
                @foreach (var message in messages)
                {
                    <div class="message-row @message.Role">
                        @if (message.Role == "assistant")
                        {
                            <div class="message-avatar">✚</div>
                        }

                        <div class="message-bubble">
                            @message.Text

                            @if (!string.IsNullOrWhiteSpace(message.Meta))
                            {
                                <div class="message-meta">@message.Meta</div>
                            }
                        </div>
                    </div>
                }

                @if (isSending)
                {
                    <div class="message-row assistant">
                        <div class="message-avatar">✚</div>
                        <div class="message-bubble loading-bubble">正在傳送至 DDM…</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="input-area">
        <div class="input-box">
            <textarea placeholder="輸入你遇到的臨床問題..."
                      rows="1"
                      @bind="question"
                      @bind:event="oninput"
                      disabled="@isSending"></textarea>

            <button class="send-button"
                    type="button"
                    title="送出至 DDM"
                    disabled="@(isSending || string.IsNullOrWhiteSpace(question))"
                    @onclick="SendQuestionAsync">
                @if (isSending)
                {
                    <span class="send-spinner"></span>
                }
                else
                {
                    <span>↑</span>
                }
            </button>
        </div>

        <div class="input-hint">
            歷史紀錄由 DDM 自動保存；左側「最近對話」依目前員工帳號載入。
        </div>
    </div>
</div>

@code {
    private string question = string.Empty;
    private string? currentThreadId;
    private bool isSending;
    private string threadTitle = "小護天使";
    private string threadSubtitle = "DDM conversation";
    private readonly List<ChatMessage> messages = [];

    protected override void OnInitialized()
    {
        HistoryState.SelectionChanged += OnHistorySelected;

        if (HistoryState.SelectedHistory is not null)
            LoadHistory(HistoryState.SelectedHistory);
    }

    private void UsePrompt(string prompt)
    {
        question = prompt;
    }

    private async Task SendQuestionAsync()
    {
        var text = question.Trim();
        if (string.IsNullOrWhiteSpace(text) || isSending)
            return;

        var isFirstMessage = messages.Count == 0;
        if (isFirstMessage)
        {
            threadTitle = BuildTitle(text);
            threadSubtitle = "DDM conversation";
        }
        else if (threadSubtitle.StartsWith("歷史紀錄", StringComparison.Ordinal))
        {
            threadSubtitle = "DDM conversation";
        }

        currentThreadId ??= Guid.NewGuid().ToString();
        messages.Add(new ChatMessage("user", text));
        question = string.Empty;
        isSending = true;

        try
        {
            var account = UserSession.Account ?? string.Empty;
            var result = await DdmApiService.ReviseTextAsync(
                text,
                account,
                currentThreadId,
                threadTitle);

            if (!result.RequestSent)
            {
                messages.Add(new ChatMessage(
                    "system error",
                    result.Error ?? "DDM request 未送出。",
                    "尚未完成傳輸驗證"));
                return;
            }

            if (!result.HttpSuccess)
            {
                messages.Add(new ChatMessage(
                    "system error",
                    result.Error ?? "DDM 回傳錯誤。",
                    $"Request 已送達 DDM · HTTP {result.StatusCode}"));
                return;
            }

            if (!string.IsNullOrWhiteSpace(result.Answer))
            {
                messages.Add(new ChatMessage(
                    "assistant",
                    result.Answer,
                    $"DDM · HTTP {result.StatusCode}"));
            }
            else
            {
                messages.Add(new ChatMessage(
                    "system success",
                    $"DDM 已成功收到請求（HTTP {result.StatusCode}），目前沒有 AI 回覆內容。",
                    $"Transport OK · HTTP {result.StatusCode}"));
            }

            // DDM 本身已負責呼叫 API_NAA /SaveHistory。
            // 前端不再重複儲存，只在 DDM 成功完成後重新讀取左側歷史紀錄。
            if (!string.IsNullOrWhiteSpace(account))
                HistoryState.RequestRefresh();
        }
        finally
        {
            isSending = false;
        }
    }

    private void OnHistorySelected(HistoryRecord? history)
    {
        _ = InvokeAsync(() =>
        {
            if (history is null)
            {
                currentThreadId = null;
                messages.Clear();
                threadTitle = "小護天使";
                threadSubtitle = "DDM conversation";
            }
            else
            {
                LoadHistory(history);
            }

            StateHasChanged();
        });
    }

    private void LoadHistory(HistoryRecord history)
    {
        messages.Clear();
        currentThreadId = history.ThreadId ?? history.UniqueId;
        threadTitle = string.IsNullOrWhiteSpace(history.ChatTitle) ? "歷史對話" : history.ChatTitle;
        threadSubtitle = history.CreatedAt is null
            ? "歷史紀錄"
            : $"歷史紀錄 · {history.CreatedAt.Value.LocalDateTime:yyyy/MM/dd HH:mm}";

        if (history.Turns.Count > 0)
        {
            foreach (var turn in history.Turns)
            {
                if (!string.IsNullOrWhiteSpace(turn.QuestionText))
                    messages.Add(new ChatMessage("user", turn.QuestionText));

                if (!string.IsNullOrWhiteSpace(turn.AnswerText))
                    messages.Add(new ChatMessage("assistant", turn.AnswerText, "已保存的歷史紀錄"));
            }
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(history.QuestionText))
                messages.Add(new ChatMessage("user", history.QuestionText));

            if (!string.IsNullOrWhiteSpace(history.AnswerText))
                messages.Add(new ChatMessage("assistant", history.AnswerText, "已保存的歷史紀錄"));
        }
    }

    private void ClearChat()
    {
        HistoryState.ClearSelection();
        currentThreadId = null;
        messages.Clear();
        question = string.Empty;
        threadTitle = "小護天使";
        threadSubtitle = "DDM conversation";
    }

    private static string BuildTitle(string text)
    {
        var value = text.Trim();
        return value.Length <= 24 ? value : $"{value[..24]}…";
    }

    public void Dispose()
    {
        HistoryState.SelectionChanged -= OnHistorySelected;
    }

    private sealed record ChatMessage(string Role, string Text, string? Meta = null);
}
