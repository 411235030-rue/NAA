@inherits LayoutComponentBase
@inject UserSession UserSession
@inject NavigationManager Navigation

@if (!UserSession.IsLoggedIn)
{
    <div class="auth-loading">正在載入...</div>
}
else
{
    <div class="naa-layout">
        <aside class="naa-sidebar">
            <NavMenu />
        </aside>

        <main class="naa-main">
            <header class="naa-topbar">
                <div class="topbar-title">臨床照護即時助手</div>

                <div class="user-area">
                    <div class="user-avatar">護</div>
                    <div class="user-info">
                        <span class="user-name">@UserSession.Account</span>
                        <span class="user-role">Nursing Assistant</span>
                    </div>
                    <button class="logout-button" @onclick="Logout">登出</button>
                </div>
            </header>

            <section class="naa-content">
                @Body
            </section>
        </main>
    </div>
}

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    private void Logout()
    {
        UserSession.Logout();
        Navigation.NavigateTo("/login", replace: true);
    }
}
