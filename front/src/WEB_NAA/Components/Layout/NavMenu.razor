@implements IDisposable
@inject UserSession UserSession
@inject HistoryApiService HistoryApiService
@inject HistoryState HistoryState
@inject NavigationManager Navigation

<div class="sidebar-container">
    <div class="brand">
        <div class="brand-icon">✚</div>
        <div>
            <div class="brand-name">小護天使</div>
            <div class="brand-subtitle">Nursing AI Assistant</div>
        </div>
    </div>

    <button class="new-chat" type="button" @onclick="StartNewChat">
        <span class="plus">＋</span>
        <span>開始新對話</span>
    </button>

    <div class="section-title">最近對話</div>

    @if (isLoading)
    {
        <div class="history-status">
            <span class="history-spinner"></span>
            <span>載入歷史紀錄…</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="history-empty history-error">
            <div class="history-empty-icon">!</div>
            <strong>暫時無法載入</strong>
            <span>@loadError</span>
        </div>
    }
    else if (historyItems.Count == 0)
    {
        <div class="history-empty">
            <div class="history-empty-icon">⌁</div>
            <strong>尚無對話紀錄</strong>
            <span>完成一組問答後，紀錄會依 @UserSession.Account 顯示在這裡。</span>
        </div>
    }
    else
    {
        <div class="history-list">
            @foreach (var item in historyItems.Take(10))
            {
                <button class="history-item @(HistoryState.SelectedHistory?.UniqueId == item.UniqueId && !string.IsNullOrWhiteSpace(item.UniqueId) ? "selected" : string.Empty)"
                        type="button"
                        title="@item.QuestionText"
                        @onclick="() => OpenHistory(item)">
                    <span class="history-title">@item.ChatTitle</span>
                    <span class="history-preview">@GetPreview(item.QuestionText)</span>
                    <small>@FormatTime(item.CreatedAt)</small>
                </button>
            }
        </div>
    }

    <div class="sidebar-bottom">
        <button class="bottom-item" type="button">
            <span class="bottom-icon">⚙</span>
            <span>個人設定</span>
        </button>
        <button class="bottom-item" type="button">
            <span class="bottom-icon">?</span>
            <span>使用說明</span>
        </button>
    </div>
</div>

@code {
    private readonly List<HistoryRecord> historyItems = [];
    private bool isLoading;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        HistoryState.RefreshRequested += OnRefreshRequested;
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        var account = UserSession.Account;
        if (string.IsNullOrWhiteSpace(account))
        {
            historyItems.Clear();
            return;
        }

        isLoading = true;
        loadError = null;

        try
        {
            var result = await HistoryApiService.GetHistoryByAccountAsync(account);
            historyItems.Clear();

            if (result.Success)
            {
                historyItems.AddRange(result.Items);
            }
            else
            {
                loadError = result.Error;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnRefreshRequested()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadHistoryAsync();
            StateHasChanged();
        });
    }

    private void OpenHistory(HistoryRecord item)
    {
        HistoryState.Select(item);
        Navigation.NavigateTo("/");
    }

    private void StartNewChat()
    {
        HistoryState.ClearSelection();
        Navigation.NavigateTo("/");
    }

    private static string GetPreview(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "已保存的對話";

        var value = text.Trim();
        return value.Length <= 30 ? value : $"{value[..30]}…";
    }

    private static string FormatTime(DateTimeOffset? time)
    {
        if (time is null)
            return "歷史紀錄";

        var local = time.Value.LocalDateTime;
        var now = DateTime.Now;

        if (local.Date == now.Date)
            return local.ToString("HH:mm");

        if (local.Date == now.Date.AddDays(-1))
            return "昨天";

        return local.ToString("MM/dd");
    }

    public void Dispose()
    {
        HistoryState.RefreshRequested -= OnRefreshRequested;
    }
}
